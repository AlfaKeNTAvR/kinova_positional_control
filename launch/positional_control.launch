<?xml version="1.0"?>
<launch>
    <!-- ============================ SETTINGS ============================= -->

    <!-- Node frequency: the frequency [Hz] which rate.sleep() function will
    attempt to maintain in the main_loop. -->
    <arg 
    name="node_frequency" 
    default="100"/>

    <arg 
    name="robot_name" 
    default="ur5"/>

    <!-- Mounting angles [degrees]: "[0.0, 0.0, 0.0]" - on the table. -->
    <arg 
    name="mounting_angles_deg" 
    default="[0.0, 0.0, 0.0]"/> 


    <!-- Starting (homing) pose in Global CS: position X, Y, Z [meters],
    orientation X, Y, Z [degrees]. Default Kinova homing pose (B button pose)
    given "[0.0, 0.0, 0.0]" mounting angles: 
    "{'position': [0.0, 0.0, 0.0], 'orientation': [0.0, 0.0, 0.0]}"  -->
    <arg 
    name="starting_pose" 
    default="{'position': [0.0, 0.0, 0.0], 'orientation': [0.0, 0.0, 0.0]}"/>

    <!-- If any of dependency or optional subfiles should not be launched (or
    are launched separately) set corresponding argument to "false". -->
    <arg 
    name="launch_relaxed_ik" 
    default="true"/>
    <arg 
    name="launch_gripper_control" 
    default="false"/>

    <!-- If set to "true" enable rosbag recording of nodes' outputs. -->
    <arg 
    name="enable_rosbag_recording" 
    default="false"/>

    <!-- ======================== END OF SETTINGS ========================== -->
    
    <group ns="/$(arg robot_name)">
        <!-- Relaxed IK (dependency): -->
        <group if="$(arg launch_relaxed_ik)">
            <include 
            file="$(find relaxed_ik_ros1)/launch/relaxed_ik.launch">
                <arg 
                name="robot_name" 
                value="$(arg robot_name)"/>
            </include>
        </group>
   
        <!-- Gripper control (optional): -->
        <group if="$(arg launch_gripper_control)">
            <node 
            pkg="kinova_positional_control" 
            type="gripper_control.py" 
            name="gripper_control" 
            output="screen">
                <param 
                name="robot_name" 
                value="$(arg robot_name)"/>
            </node>   
        </group>

        <!-- Positional control: -->     
        <node 
        pkg="kinova_positional_control" 
        type="positional_control.py"
        name="positional_control" 
        output="screen">
            <param 
            name="node_frequency" 
            value="$(arg node_frequency)"/>
            <param 
            name="robot_name" 
            value="$(arg robot_name)"/>
            <param 
            name="mounting_angles_deg" 
            value="$(arg mounting_angles_deg)"/>
            <param 
            name="starting_pose" 
            value="$(arg starting_pose)"/>
        </node>     
    </group>

    <!-- Rosbag: -->
    <group if="$(arg enable_rosbag_recording)">
        <node 
        pkg="rosbag" 
        type="record" 
        name="rosbag"
        ns="/$(arg robot_name)/positional_control"
        output="screen"
        args="
        /$(arg robot_name)/positional_control/is_initialized
        /$(arg robot_name)/in/cartesian_velocity
        /$(arg robot_name)/relaxed_ik/ee_pose_goals
        /$(arg robot_name)/relaxed_ik/commanded_pose_gcs
        -o $(find kinova_positional_control)/bagfiles/positional_control/$(arg robot_name)
        ">
        </node>    
    </group>
</launch>